            "N": { "min": 0, "max": 100, "unidad": "dias" }
          }
        }
      },
      "depende_de": [],
      "nota": "La EDAD ademas alimenta el componente etario del APACHE II."
    },
    {
      "orden": 11,
      "nombre": "SEXO",
      "descripcion": "Sexo genotipico del paciente",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "sexo",
      "validacion": { "tipo": "texto", "enum": ["M", "F", "O"] },
      "depende_de": []
    },
    {
      "orden": 12,
      "nombre": "MOTING",
      "descripcion": "Motivo de ingreso. Para adultos es la categoria Knauss del APACHE II.",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "moting",
      "validacion": {
        "tipo": "entero",
        "enum": [1, 2, 3, 4, 99],
        "etiquetas": {
          "1": "Patologia Medica",
          "2": "Cirugia de Urgencia",
          "3": "Cirugia Programada",
          "4": "Politrauma",
          "99": "Desconocido"
        }
      },
      "depende_de": [],
      "nota_pediatria": "Para P/N el enum es [1,2,3,4,5,10,99] segun Anexo A3. Fuera de alcance.",
      "nota": "Este campo determina los puntos de salud cronica del APACHE II (categoria Knaus): 3 = postoperatorio programado (2 pts), 2 y 4 = urgencia (5 pts), 1 = no quirurgico (5 pts). Solo se aplican si el episodio tiene enfermedad_cronica_grave = true."
    },
    {
      "orden": 13,
      "nombre": "PROCEDENCIA",
      "descripcion": "Ubicacion del paciente antes de ingresar en la UCI",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "procedencia",
      "validacion": {
        "tipo": "entero",
        "min": 1,
        "max": 14,
        "etiquetas": {
          "1": "Guardia",
          "2": "Sector de clinica",
          "3": "Sala de parto",
          "4": "Piso de otro hospital",
          "5": "UTI de otro hospital",
          "6": "Terapia Intermedia",
          "7": "Sector de cirugia",
          "8": "Via publica",
          "9": "Unidad coronaria",
          "10": "Quirofano programado",
          "11": "Quirofano de urgencia",
          "12": "Otra",
          "13": "Atencion domiciliaria",
          "14": "Guardia de otro hospital"
        }
      },
      "depende_de": []
    },
    {
      "orden": 14,
      "nombre": "SCORE",
      "descripcion": "Puntaje de prediccion de mortalidad. Adultos: APACHE II.",
      "origen": "derivado",
      "funcion": "apache_score",
      "regla": "APACHE II = puntos fisiologicos (PEORES valores de las primeras 24hs desde el ingreso) + puntos por edad + puntos por salud cronica. Los peores valores se seleccionan por variable sobre todos los eventos 'fisiologico_24h' con timestamp_clinico dentro de las 24hs del ingreso.",
      "validacion": { "tipo": "entero", "min": 0, "max": 71 },
      "depende_de": ["fisiologico_24h"],
      "nota_pediatria": "Para P/N seria PIM3, decimal entre -6.00 y 25.00. Fuera de alcance."
    },
    {
      "orden": 15,
      "nombre": "PROBABMORT",
      "descripcion": "Probabilidad de muerte estimada por el score, en porcentaje.",
      "origen": "derivado",
      "funcion": "apache_probabilidad",
      "regla": "Regresion logistica de Knaus 1985: logit = -3.517 + (APACHE II * 0.146) + (0.603 si postoperatorio de urgencia) + coeficiente por categoria diagnostica. PROBABMORT = 100 / (1 + exp(-logit)), redondeado a 2 decimales.",
      "validacion": { "tipo": "decimal", "min": 0, "max": 99.9, "decimales": 2 },
      "depende_de": ["fisiologico_24h"]
    },

