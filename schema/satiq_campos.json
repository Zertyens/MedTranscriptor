{
  "_meta": {
    "descripcion": "Fuente unica de verdad de la fila de reporte SATI-Q. Este archivo maneja TRES cosas a la vez: (1) el orden exacto de columnas del CSV, (2) como se proyecta cada campo desde los eventos, (3) como se valida cada campo. Si un campo cambia, se cambia aca y en ningun otro lado.",
    "version_eds": "EDS V2026 SATI-Q",
    "fuente_definiciones": "Anexo A1",
    "fuente_orden_columnas": "Anexo A4 (header literal)",
    "total_campos": 49,
    "nota_49_vs_48": "El CONTEXT.txt del proyecto dice 48 campos. El header real del Anexo A4 tiene 49. Manda el A4.",
    "alcance_hackathon": "Solo pacientes adultos (TIPO=A). Los rangos pediatricos/neonatales quedan documentados en 'nota_pediatria' pero no se calculan.",
    "formato": {
      "fecha": "dd/mm/aaaa",
      "hora": "HH:mm:ss",
      "decimal_separador": ".",
      "decimal_max_digitos": 2,
      "csv_delimitador": ",",
      "csv_encoding": "utf-8"
    },
    "origenes": {
      "config": "Valor fijo de la configuracion del centro. No sale de eventos.",
      "episodio": "Dato administrativo cargado al abrir el episodio. No sale de eventos.",
      "derivado": "Python lo calcula proyectando los eventos. NUNCA se carga a mano."
    },
    "trazabilidad": "Todo campo con origen 'derivado' devuelve, ademas del valor, la lista de ids de evento que lo originaron. Los campos 'config' y 'episodio' devuelven lista vacia."
  },

  "campos": [
    {
      "orden": 1,
      "nombre": "IDCENTRO",
      "descripcion": "Identificador unico del Centro",
      "origen": "config",
      "funcion": "constante_centro",
      "validacion": { "tipo": "texto", "min_largo": 1, "max_largo": 64 },
      "depende_de": []
    },
    {
      "orden": 2,
      "nombre": "IDPACIENTE",
      "descripcion": "Identificador unico asociado con un paciente. Entero secuencial desde el primer egreso del anio en curso.",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "idpaciente",
      "validacion": { "tipo": "entero", "min": 1, "max": 999999999 },
      "depende_de": []
    },
    {
      "orden": 3,
      "nombre": "REINGRESO",
      "descripcion": "Reingreso dentro de las 48hs a la UCI por causa no prevista (Anexo A2).",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "reingreso",
      "validacion": { "tipo": "entero", "enum": [0, 1] },
      "depende_de": [],
      "nota": "DECISION: para el hackathon se carga a mano al abrir el episodio. Es derivable si existiera el episodio previo del mismo paciente (delta < 48hs entre egreso anterior e ingreso actual)."
    },
    {
      "orden": 4,
      "nombre": "FECHING",
      "descripcion": "Fecha de ingreso a la UCI",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "fecha_ingreso",
      "validacion": { "tipo": "fecha", "formato": "dd/mm/aaaa" },
      "depende_de": []
    },
    {
      "orden": 5,
      "nombre": "HORAING",
      "descripcion": "Hora de ingreso a la UCI",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "hora_ingreso",
      "validacion": { "tipo": "hora", "formato": "HH:mm:ss" },
      "depende_de": []
    },
    {
      "orden": 6,
      "nombre": "FECEGR",
      "descripcion": "Fecha de egreso de la UCI",
      "origen": "derivado",
      "funcion": "egreso_fecha",
      "regla": "Fecha del unico evento tipo 'egreso' del episodio (parte fecha de timestamp_clinico).",
      "validacion": { "tipo": "fecha", "formato": "dd/mm/aaaa", "no_anterior_a": "FECHING" },
      "depende_de": ["egreso"]
    },
    {
      "orden": 7,
      "nombre": "HORAEGR",
      "descripcion": "Hora de egreso de la UCI",
      "origen": "derivado",
      "funcion": "egreso_hora",
      "regla": "Hora del evento tipo 'egreso' (parte hora de timestamp_clinico).",
      "validacion": { "tipo": "hora", "formato": "HH:mm:ss" },
      "depende_de": ["egreso"]
    },
    {
      "orden": 8,
      "nombre": "ESTADIA",
      "descripcion": "Estadia del paciente en la UCI, en dias.",
      "origen": "derivado",
      "funcion": "estadia",
      "regla": "max(1, (FECEGR - FECHING).days). Computa el dia de ingreso pero NO el de egreso. Si ingresa y egresa el mismo dia, 1. Verificado contra el ejemplo del Anexo A4: 01/03/2025 -> 01/04/2025 = 31.",
      "validacion": { "tipo": "entero", "min": 1, "max": 365 },
      "depende_de": ["egreso"]
    },
    {
      "orden": 9,
      "nombre": "TIPO",
      "descripcion": "Tipo de paciente segun su edad",
      "origen": "episodio",
      "funcion": "campo_episodio",
      "arg": "tipo",
      "validacion": { "tipo": "texto", "enum": ["A", "P", "N"] },
      "depende_de": [],
      "nota": "Alcance hackathon: solo 'A' (adulto). P y N se validan pero no se calcula su score."
    },
    {
      "orden": 10,
      "nombre": "EDAD",
      "descripcion": "Edad del paciente al ingreso en la UCI",
      "origen": "episodio",
